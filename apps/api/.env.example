# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spontaneous_social?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string
JWT_REFRESH_EXPIRATION=7d

# S3 / Cloudflare R2
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=spontaneous-social-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://spontaneous-social-uploads.s3.us-east-1.amazonaws.com

# AI (optional — enables smart chat suggestions)
ANTHROPIC_API_KEY=

# App
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
