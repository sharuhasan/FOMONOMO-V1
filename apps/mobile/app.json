{
  "expo": {
    "name": "Spontaneous Social",
    "slug": "spontaneous-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spontaneous-social",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#faf6f1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fomonomo.spontaneoussocial",
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show activities near you.",
        "NSCameraUsageDescription": "We need camera access so you can take profile photos.",
        "NSPhotoLibraryUsageDescription": "We need photo library access so you can choose a profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf6f1"
      },
      "package": "com.fomonomo.spontaneoussocial",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show activities near your current location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B6B"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
